# Alpaca credentials (server-side ONLY — never expose to the apps or commit this file)
# Get keys at https://app.alpaca.markets/ (paper keys by default)

# Trading base: paper uses https://paper-api.alpaca.markets
# Set to "false" ONLY for live real-money trading (funded account required).
ALPACA_PAPER=true
ALPACA_KEY=your_api_key_id_here
ALPACA_SECRET=your_api_secret_here

# The shared token the desktop/mobile apps send as: Authorization: Bearer <SERVER_TOKEN>
# Change this to a long random string.
SERVER_TOKEN=change-me-to-a-long-random-token

# Port the backend listens on (desktop/mobile call this URL)
PORT=8080
