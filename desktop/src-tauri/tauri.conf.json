{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NSE Market Hub",
  "version": "1.0.0",
  "identifier": "com.nsemarkethub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NSE Market Hub",
        "width": 1280,
        "height": 800,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "http": {
      "scope": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://discord.com/api/*" },
        { "url": "https://ptb.discord.com/api/*" }
      ]
    }
  }
}
